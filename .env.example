# Local development only; choose a URL-safe password and keep this file private.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql+psycopg://steelos:replace-with-local-password@localhost:5432/steelos

# Optional read-only assistant: disabled by default; no paid API key is used.
ASSISTANT_PROVIDER=disabled
# Host Python uses http://127.0.0.1:11434; Compose uses http://ollama:11434.
# ASSISTANT_OLLAMA_URL=http://127.0.0.1:11434

# Optional internal drafting with the existing local Ollama; no paid API.
AGENT_WORKBENCH_PROVIDER=disabled
AGENT_WORKBENCH_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Optional: OLLAMA_MEMORY_LIMIT=6g for the internal drafting model.
